rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================
    // USERS (READ: próprio usuário + ADMIN; WRITE: NÃO — apenas Admin SDK)
    // ========================
    match /users/{userId} {
      allow read: if (
        request.auth != null &&
        (request.auth.uid == userId ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN'])
      );
      allow write: if false;
    }

    // ========================
    // TRAINING_MODULES / TRAINING_LESSONS (READ: todos logados; WRITE: só Admin SDK)
    // ========================
    match /training_modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /training_lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ========================
    // LESSON_PROGRESS (READ: próprio + ADMIN; WRITE: NÃO)
    // ========================
    match /lesson_progress/{progressId} {
      allow read: if (
        request.auth != null &&
        (resource.data.user_id == int(request.auth.uid) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN'])
      );
      allow write: if false;
    }

    // ========================
    // QUIZ_ATTEMPTS + subcoleção ANSWERS
    // ========================
    match /quiz_attempts/{attemptId} {
      allow read: if (
        request.auth != null &&
        (resource.data.user_id == int(request.auth.uid) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN'])
      );
      allow write: if false;

      match /answers/{answerId} {
        allow read: if (
          request.auth != null &&
          (get(/databases/$(database)/documents/quiz_attempts/$(attemptId)).data.user_id == int(request.auth.uid) ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN'])
        );
        allow write: if false;
      }
    }

    // ========================
    // CHECKPOINT_ANSWERS
    // ========================
    match /checkpoint_answers/{answerId} {
      allow read: if (
        request.auth != null &&
        (resource.data.user_id == int(request.auth.uid) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN'])
      );
      allow write: if false;
    }

    // ========================
    // AUDIT_LOGS (SÓ ADMIN READ; NENHUM WRITE via client)
    // ========================
    match /audit_logs/{logId} {
      allow read: if (
        request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN']
      );
      allow write: if false;
    }

    // ========================
    // DEFAULT: BLOQUEIA TUDO
    // ========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
